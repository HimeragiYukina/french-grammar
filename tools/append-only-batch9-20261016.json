          ],
          "prefix_length": 1,
          "prefix_sha256": "530d0cb4a67491343701bea7b8f8b7212edd6b21ab424166cba1b1342bc5fec2",
          "added": []
        },
        {
          "operation": "append",
          "path": [
            "a2-coi",
            "practice"
          ],
          "prefix_length": 4,
          "prefix_sha256": "bdc9799e87799293417001cc9d327269295fd710569daa4942e16e18199abbd2",
          "added": [
            {
              "q": "分别把Marie替成代词：Je préviens Marie avant mon départ. Je téléphone à Marie. 保留两个动词。",
              "a": "Je la préviens avant mon départ. Je lui téléphone.",
              "note": "prévenir quelqu’un直接接人，用la；téléphoner à quelqu’un用lui。人物对象不自动都是间接宾语；prévenir此处是告知。"
            },
            {
              "q": "Marc和Nadia都需要收到出发消息。用将来时分别说“我会提前告知他们”“我会给他们打电话”，使用prévenir与téléphoner及代词。",
              "a": "Je les préviendrai. Je leur téléphonerai.",
              "note": "prévenir是直接宾语，用les；téléphoner à是间接宾语，用leur。这里leur是不变的代词，不写leurs。"
            }
          ]
        }
      ]
    },
    {
      "file": "tools/supplement-c2.json",
      "before_sha256": "9ae3ee3011668152ac06b645537b4df232850b362bfc42e165a9be41d724f92c",
